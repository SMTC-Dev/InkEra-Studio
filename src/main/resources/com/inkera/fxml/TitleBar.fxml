<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>

<HBox fx:id="titleBar" alignment="CENTER_LEFT" prefHeight="38.0" minHeight="38.0" maxHeight="38.0" spacing="10.0"
      style="-fx-background-color: #181819; -fx-border-color: #2d2d30; -fx-border-width: 0 0 1 0;"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.inkera.ui.controllers.TitleBarController"
      onMousePressed="#handleMousePressed" onMouseDragged="#handleMouseDragged">

    <padding>
        <Insets left="14.0" right="0.0" />
    </padding>

    <!-- BOZUK SVG YERİNE KRİTA'DA HAZIRLADIĞIN GERÇEK PNG LOGO EKLENDİ -->
    <ImageView fitHeight="22.0" fitWidth="22.0" pickOnBounds="true" preserveRatio="true" smooth="true">
        <image>
            <Image url="@../assets/AppLogo.png" requestedWidth="22" requestedHeight="22" preserveRatio="true" smooth="true" />
        </image>
    </ImageView>

    <HBox alignment="CENTER_LEFT" spacing="6.0" mouseTransparent="true">
        <Label text="InkEra" style="-fx-text-fill: #fdb547; -fx-font-weight: bold; -fx-font-size: 13px;" />
        <Label fx:id="titleLabel" text="Studio" style="-fx-text-fill: #cccccc; -fx-font-weight: normal; -fx-font-size: 12.5px;" />
    </HBox>

    <Region HBox.hgrow="ALWAYS" />

    <HBox alignment="CENTER_RIGHT">
        <Button fx:id="minimizeBtn" text="−" onAction="#minimize" prefWidth="46.0" prefHeight="38.0"
                styleClass="title-button" />

        <Button fx:id="closeBtn" text="✕" onAction="#close" prefWidth="46.0" prefHeight="38.0"
                styleClass="title-button, title-button-close" />
    </HBox>

</HBox>
